index b82ba71..83e8761 100644
--- a/assets/css/explainer.css
+++ b/assets/css/explainer.css
@@ -1149,7 +1149,7 @@ ul.cheat li, .cheat li { background: none; border-top: 1px solid var(--line); pa
 /* status lines are prose, not code: body face */
 .status-line { font-family: var(--font-body); font-size: var(--text-sm); }
 /* top bar playback controls: one height, square, the same hairline */
-.ac-speed select, .ac-step { min-height: 36px; border: 0; box-shadow: inset 0 0 0 1px var(--line); background: var(--bg); }
+.ac-speed select, .ac-step { min-height: 36px; border: 0; box-shadow: inset 0 0 0 1px var(--muted); background: var(--bg); }
